{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:pricing": "tsx scripts/test-pricing-gatekeeper.ts",
    "test:geo": "tsx scripts/test-geo-multicity.ts",
    "test:all": "npm run test:pricing && npm run test:geo",
    "emulators": "firebase emulators:start --project gen-lang-client-0838883154 --only auth,firestore,storage",
    "emulators:export": "firebase emulators:export ./test/emulator-data",
    "test:sandbox": "firebase emulators:exec --project gen-lang-client-0838883154 --only auth,firestore,storage \"npx tsx scripts/virtual-sandbox-runner.ts\"",
    "test:concurrency": "firebase emulators:exec --project gen-lang-client-0838883154 --only auth,firestore,storage \"FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 npx tsx scripts/concurrency-sandbox-runner.ts\"",
    "test:settlement": "npx firebase-tools@15.32.1 emulators:exec --project gen-lang-client-0838883154 --only firestore \"npx tsx scripts/test-ride-settlement.ts\"",
    "test:financial-reconciliation": "npx firebase-tools@15.32.1 emulators:exec --project gen-lang-client-0838883154 --only firestore \"npx tsx scripts/test-financial-reconciliation.ts\"",
    "test:auth": "tsx scripts/test-auth-mysql.ts",
    "test:rides": "tsx scripts/test-rides-mysql.ts",
    "test:realtime": "tsx scripts/test-realtime-mysql.ts",
    "test:app": "tsx scripts/test-app-client.ts",
    "test:food": "tsx scripts/test-food-mysql.ts",
    "test:admin": "tsx scripts/test-admin-mysql.ts",
    "test:wallet": "tsx scripts/test-wallet-mysql.ts",
    "test:driver-documents": "tsx scripts/test-driver-documents-mysql.ts",
    "test:order-history": "tsx scripts/test-order-history-mysql.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "^8.0.2",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "twilio": "^6.3.0",
    "vite": "^6.2.3",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
