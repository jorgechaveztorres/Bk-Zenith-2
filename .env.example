# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform.
# Must belong to Google Cloud Project: gen-lang-client-0838883154 (949145719529)
# Required APIs: Maps JavaScript API, Geocoding API, Directions API.
# Users configure this via the Secrets panel in the AI Studio UI.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_KEY"

# FIREBASE_EMULATOR_SUITE (Sandbox / Local Stress Testing Isolation):
# Set to "true" to isolate all database, auth, and storage tests in local emulators
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_STORAGE_EMULATOR_HOST=localhost
VITE_STORAGE_EMULATOR_PORT=9199

# ---------------------------------------------------------------
# MYSQL (cPanel) — reemplaza Firestore
# ---------------------------------------------------------------
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="shocos_zenith"
DB_PASSWORD=""
DB_NAME="shocos_zenith"

# LOGIN — firma de sesiones. Mínimo 32 caracteres aleatorios. Nunca compartirla.
JWT_SECRET=""
# o bien: ruta a un archivo privado que el servidor crea solo la primera vez
JWT_SECRET_FILE=""

# SMS — "console" = modo prueba (el código solo sale en el log del servidor)
SMS_PROVIDER="console"

# Subcarpeta donde vive la app en cPanel (ej. /zenith-api). Vacío si está en la raíz.
BASE_PATH=""

# RUTAS — "google" = Google Routes API (cuesta). Vacío = estimación gratuita (línea recta x 1.35).
ROUTE_PROVIDER=""
