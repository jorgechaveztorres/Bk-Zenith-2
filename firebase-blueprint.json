{
  "entities": {
    "User": {
      "title": "Zenith User",
      "description": "A participant in the Zenith network (Client or Operator)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["passenger", "driver"] },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role"]
    },
    "Ride": {
      "title": "Operation",
      "description": "An active urban operation / transit request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "passengerId": { "type": "string" },
        "driverId": { "type": "string" },
        "origin": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "destination": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "suggestedPrice": { "type": "number" },
        "finalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "negotiating", "accepted", "in_progress", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["passengerId", "origin", "destination", "suggestedPrice", "status"]
    },
    "Offer": {
      "title": "Tactical Bid",
      "description": "An operational bid from an Operator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rideId": { "type": "string" },
        "driverId": { "type": "string" },
        "price": { "type": "number" },
        "driverName": { "type": "string" },
        "driverRating": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rideId", "driverId", "price", "status"]
    },
    "TopupRequest": {
      "title": "Wallet Topup Request",
      "description": "A pilot Yape topup request for driver pre-paid wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referenceCode": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "requestedAmount": { "type": "number" },
        "verifiedAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["CREATED", "RECEIPT_SUBMITTED", "EXTRACTED_BY_AI", "RECONCILING", "VERIFIED", "REVIEW", "REJECTED", "CREDITED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "referenceCode", "driverId", "requestedAmount", "status"]
    },
    "BankMovement": {
      "title": "Confirmed Bank Movement",
      "description": "Operator confirmed physical reception in Yape account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "payerName": { "type": "string" },
        "operatorId": { "type": "string" },
        "status": { "type": "string", "enum": ["UNCLAIMED", "MATCHED", "DISPUTED"] }
      },
      "required": ["id", "amount", "date", "payerName", "operatorId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Profiles for Zenith network participants"
    },
    "/rides/{rideId}": {
      "schema": "Ride",
      "description": "Active urban operations"
    },
    "/rides/{rideId}/offers/{offerId}": {
      "schema": "Offer",
      "description": "Operator bids for specific operations"
    },
    "/topup_requests/{topupId}": {
      "schema": "TopupRequest",
      "description": "Pilot Yape topup requests with immutable audit trail"
    },
    "/bank_movements/{movementId}": {
      "schema": "BankMovement",
      "description": "Operator verified bank incoming movements"
    }
  }
}
