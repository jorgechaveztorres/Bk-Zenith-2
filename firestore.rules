rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Zero Trust: everything closed by default)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        request.auth.token.email == 'bkheelsec@gmail.com'
      );
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); // El administrador requiere listar conductores para validación
      allow create: if isOwner(userId)
        && request.resource.data.role in ['passenger', 'driver']
        && request.resource.data.uid == userId;
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wallet', 'role', 'isAdmin'])
      );
      allow delete: if isAdmin();
    }

    // Wallets (Billetera)
    match /wallets/{userId} {
      allow get: if isOwner(userId);
      allow write: if false; // El dinero es sagrado, solo modificado server-side (Cloud Functions)
    }

    // Wallet Movements Subcollection
    match /wallets/{userId}/movements/{movementId} {
      allow get, list: if isOwner(userId);
      allow write: if false; // Solo por backend
    }

    // Rides (Viajes de Zénith con Tarifa Protegida)
    match /rides/{rideId} {
      function isRidePassenger(resourceData) {
        return resourceData.passengerId == request.auth.uid;
      }
      function isRideDriver(resourceData) {
        return resourceData.driverId == request.auth.uid;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Los conductores necesitan buscar viajes solicitados

      // Zero-Trust: Creación exclusiva por Backend Gatekeeper (POST /api/rides/request vía Firebase Admin SDK)
      allow create: if false;

      allow update: if isSignedIn() 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'protectedPrice', 'finalPrice', 'basePrice', 'pricingSeal', 
          'quoteId', 'pricingVersion', 'multiplier', 'marketPressure', 
          'distance', 'currency', 'status', 'otpHash', 'otpVerified', 
          'otpAttempts', 'otpMaxAttempts', 'otpExpiresAt', 'driverId', 'passengerId'
        ]) && (
        // Pasajero califica viaje una vez completado
        (isRidePassenger(resource.data) && resource.data.status == 'COMPLETED' && request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'feedback', 'updatedAt'])) ||
        // Conductor asignado actualiza exclusivamente telemetría GPS en tiempo real
        (isRideDriver(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverLocation', 'updatedAt']))
      );
    }

    // In-app Notifications Subcollection (Notificaciones)
    match /users/{userId}/notifications/{notifId} {
      allow read, list: if isOwner(userId);
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Solo creadas por backend
    }

    // Accounting Ledger (Libro contable inmutable)
    match /accounting_ledger/{ledgerId} {
      allow get, list: if isAdmin();
      allow write: if false; // Solo backend
    }

    // Transactions
    match /transactions/{txId} {
      allow get, list: if isSignedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow write: if false; // Solo Server-Side
    }

    // Payments (Pagos)
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow write: if false; // Validado y procesado exclusivamente en el servidor
    }

    // Audit Logs (Auditoría inmutable para auditoría financiera y eventos críticos)
    match /audit_logs/{logId} {
      allow read, write: if false; // Inmutable, creados solo vía Backend (Server Authority)
    }

    // Idempotency Keys (Control atómico de concurrencia y reintentos)
    match /idempotency_keys/{keyId} {
      allow read, write: if false; // Exclusivo del Backend Gatekeeper (Server Authority)
    }

    // History (Historial de Servicios Cerrados)
    match /history/{historyId} {
      allow get: if isSignedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow list: if isSignedIn(); // El listado debe filtrarse por userId en consultas del cliente
      allow write: if false; // Solo archivado mediante procesos automáticos del backend
    }

    // Driver Audits (Trazabilidad inmutable de conductores)
    match /driver_audits/{auditId} {
      allow create: if isSignedIn();
      allow read, list: if isAdmin();
      allow update, delete: if false; // Totalmente inmutable
    }

    // Drivers Online (Conductores Conectados)
    match /drivers_online/{driverId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == driverId;
      allow delete: if isSignedIn() && request.auth.uid == driverId;
    }

    // Assignments (Ofertas de Viaje de 15 Segundos)
    match /assignments/{assignmentId} {
      allow read, list, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Dispatch Logs (Auditoría de Despacho Inteligente)
    match /dispatch_logs/{logId} {
      allow create: if isSignedIn();
      allow read, list: if isSignedIn();
      allow update, delete: if false; // Inmutable
    }

    // Topup Requests (Solicitudes de Recarga de Wallet V1 - Piloto Yape)
    match /topup_requests/{topupId} {
      allow get: if isSignedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn(); // Filtrado por driverId en consultas del cliente
      allow write: if false; // Modificaciones de estado y saldo ocurren exclusivamente en Backend Express
    }

    // Processed Bank Movements (Idempotencia Inmutable de Recargas)
    match /processed_bank_movements/{movementId} {
      allow read: if isAdmin();
      allow write: if false; // Solo por backend atómico
    }

    // Bank Movements (Confirmaciones Manuales de Movimiento Real)
    match /bank_movements/{movementId} {
      allow read: if isAdmin();
      allow write: if false; // Solo por backend
    }
  }
}
